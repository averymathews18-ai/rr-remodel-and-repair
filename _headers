# Netlify cache headers (ignored by other hosts).
# Hashed build assets: safe to cache forever.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Brand + gallery media: 30 days. RULE: if an image is ever replaced, give the
# new file a NEW NAME (CDNs cache by path — same-name swaps serve stale for days).
/brand/*
  Cache-Control: public, max-age=2592000
/gallery/*
  Cache-Control: public, max-age=2592000

# HTML: always revalidate so deploys show up immediately.
/*.html
  Cache-Control: public, max-age=0, must-revalidate
/
  Cache-Control: public, max-age=0, must-revalidate
